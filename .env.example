# Contoh konfigurasi. Salin menjadi `.env` dan isi nilainya.
# Jangan pernah commit `.env` - ia memuat kunci API dan token Hugging Face.

# ── Aplikasi ────────────────────────────────────────────────────────────────
APP_NAME=NLP Analysis API
APP_VERSION=1.0.0
# `production` mengaktifkan penjaga keamanan: /docs disembunyikan dan layanan
# MENOLAK START bila API_KEY kosong.
APP_ENV=production
DEBUG=false
# 127.0.0.1 untuk VPS tunggal (Laravel memanggil lewat loopback). Railway,
# HF Spaces, dan Dockerfile memberi --host 0.0.0.0 di perintah uvicorn-nya
# sendiri, jadi nilai ini tidak berlaku di sana.
HOST=127.0.0.1
# Railway dan HF Spaces menyuntikkan PORT sendiri; biarkan kosong di sana.
PORT=8001

# ── Keamanan (WAJIB untuk deployment publik) ────────────────────────────────
# Kunci bersama yang harus dikirim pemanggil lewat header `X-API-Key`.
# Samakan persis dengan NLP_API_KEY di .env milik text-analysis-web.
# Bangkitkan dengan:  python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=

# Nyalakan HANYA bila layanan berada di belakang proxy (Railway, HF Spaces,
# nginx). Bila tidak, header X-Forwarded-For bisa dipalsukan untuk melewati
# batas laju.
TRUST_PROXY=true

# Batas laju per alamat IP. 0 mematikannya (sah bila sudah ada pembatas di
# lapisan depan).
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW=60

# Biarkan false di produksi: skema OpenAPI memberi tahu persis bentuk muatan
# /api/retrain/*.
EXPOSE_DOCS=false

# ── Analisis saat pelatihan ─────────────────────────────────────────────────
# true: analisis yang butuh model yang sedang dilatih dibalas 503 + Retry-After
# alih-alih menunggu lock. Nyalakan HANYA setelah Laravel membaca Retry-After
# dan mengantrekan ulang job-nya; sebelum itu, biarkan false.
RETRAIN_REJECT_INFERENCE=false
# Detik per sampel kolam untuk satu putaran penuh; dipakai memperkirakan
# Retry-After. Angka bawaan diukur di laptop 8 core. Ukur ulang di produksi.
RETRAIN_SEC_PER_SAMPLE_SENTIMENT=1.7
RETRAIN_SEC_PER_SAMPLE_ASPECT=1.1

# ── CORS ────────────────────────────────────────────────────────────────────
# URL publik aplikasi Laravel. Ditambahkan otomatis ke daftar origin.
LARAVEL_PUBLIC_URL=

# ── Penyimpanan bobot ───────────────────────────────────────────────────────
# Direktori checkpoint. Di produksi HARUS menunjuk ke volume permanen,
# kalau tidak hasil retraining hilang pada redeploy berikutnya.
MODEL_PATH=/data/models

# Alternatif (atau pelengkap) volume: simpan bobot di Hugging Face Hub.
# Repo privat, mis. "namauser/skripsi-nlp-weights". Kosong = sinkronisasi mati.
# Bobot ditarik saat start dan didorong setiap retraining yang diterima,
# sehingga tiap iterasi active learning menjadi satu commit.
HF_WEIGHTS_REPO=
HF_TOKEN=

USE_GPU=false

# ── Batas permintaan ────────────────────────────────────────────────────────
MAX_TEXT_LENGTH=10000
MAX_BATCH_SIZE=10000

# ── Log ─────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=logs/api.log

# ── Protokol active learning ────────────────────────────────────────────────
# Tiap putaran dilatih dari bobot dasar atas seluruh kolam koreksi, bukan
# melanjutkan checkpoint sebelumnya. Lihat app/config.py untuk alasannya.
RETRAIN_FROM_BASELINE=true
# Titik awal modul aspek: checkpoint SEBELUM active learning (K6), bukan
# IndoBERT mentah.
ASPECT_BASELINE_CHECKPOINT=/data/models/aspect_baseline.pt
